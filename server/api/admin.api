	// 预览生成的代码
	@handler Preview
	post /preview (PreviewReq) returns (Response)

	// CreateTemp 创建模板接口
	// 创建代码生成模板
	@handler CreateTemp
	post /createTemp (CreateTemplateReq) returns (Response)

	// AddFunc 添加功能接口
	// 添加生成功能
	@handler AddFunc
	post /addFunc (AddFuncReq) returns (Response)

	// Mcp MCP接口
	// MCP相关操作
	@handler Mcp
	post /mcp (McpReq) returns (Response)

	// McpStatus 获取MCP状态接口
	// 获取MCP服务状态
	@handler McpStatus
	post /mcpStatus returns (McpStatusRes)

	// McpStart 启动MCP接口
	// 启动MCP服务
	@handler McpStart
	post /mcpStart returns (Response)

	// McpStop 停止MCP接口
	// 停止MCP服务
	@handler McpStop
	post /mcpStop returns (Response)

	// McpList 获取MCP列表接口
	// 获取MCP列表
	@handler McpList
	post /mcpList returns (Response)

	// McpRoutes 获取MCP路由接口
	// 获取MCP路由列表
	@handler McpRoutes
	post /mcpRoutes returns (Response)

	// McpTest 测试MCP接口
	// 测试MCP连接
	@handler McpTest
	post /mcpTest returns (Response)

	// GetPackage 获取包列表接口
	// 获取代码生成包列表
	@handler GetPackage
	post /getPackage returns ([]PackageInfo)

	// DelPackage 删除包接口
	// 删除代码生成包
	@handler DelPackage
	post /delPackage (DeletePackageReq) returns (Response)

	// CreatePackage 创建包接口
	// 创建代码生成包
	@handler CreatePackage
	post /createPackage (CreatePackageReq) returns (Response)

