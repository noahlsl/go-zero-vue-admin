	post /llmAutoSSE returns (Response)

	// InitMenu 初始化菜单接口
	// 初始化菜单配置
	@handler InitMenu
	post /initMenu (DeletePackageReq) returns (Response)

	// InitAPI 初始化API接口
	// 初始化API配置
	@handler InitAPI
	post /initAPI (DeletePackageReq) returns (Response)

	// InitDictionary 初始化字典接口
	// 初始化字典配置
	@handler InitDictionary
	post /initDictionary (DeletePackageReq) returns (Response)
}

