		// ID 技能ID
		ID uint `json:"id"`
	}
	// DownloadOnlineSkillReq 下载在线技能请求参数
	// 下载在线技能时提交的数据
	DownloadOnlineSkillReq {
		// Url 技能下载地址
		Url string `json:"url"`
	}
	// DownloadOnlineSkillRes 下载在线技能响应
	// 下载结果
	DownloadOnlineSkillRes {
		// Success 是否成功
		Success bool `json:"success"`
	}
)

// 公告模块类型定义
type (
	// AnnouncementInfo 公告信息模型
	// 包含公告的基本信息和关联数据
	AnnouncementInfo {
		// ID 公告ID
		ID uint `json:"ID"`
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// Title 公告标题
		Title string `json:"title"`
		// Content 公告内容
		Content string `json:"content"`
		// UserID 发布者用户ID，可选参数
		UserID *int `json:"userID"`
		// Attachments 附件JSON字符串
		Attachments string `json:"attachments"`
	}
	// CreateAnnouncementInfoReq 创建公告请求参数
	// 创建新公告时提交的数据
	CreateAnnouncementInfoReq {
		// Title 公告标题
		Title string `json:"title"`
		// Content 公告内容
		Content string `json:"content"`
		// UserID 发布者用户ID，可选参数
		UserID *int `json:"userID,optional"`
		// Attachments 附件，可选参数
		Attachments string `json:"attachments,optional"`
	}
	// UpdateAnnouncementInfoReq 更新公告请求参数
	// 更新公告信息时提交的数据
	UpdateAnnouncementInfoReq {
		// ID 公告ID
		ID uint `json:"ID"`
		// Title 公告标题
		Title string `json:"title"`
		// Content 公告内容
		Content string `json:"content"`
		// UserID 发布者用户ID，可选参数
		UserID *int `json:"userID,optional"`
		// Attachments 附件，可选参数
		Attachments string `json:"attachments,optional"`
	}
	// DeleteAnnouncementInfoReq 删除公告请求参数
	// 删除公告时提交的数据
	DeleteAnnouncementInfoReq {
		// ID 公告ID
		ID uint `json:"ID"`
	}
	// DeleteAnnouncementInfoByIdsReq 批量删除公告请求参数
	// 批量删除公告时提交的数据
	DeleteAnnouncementInfoByIdsReq {
		// IDs 公告ID列表
		IDs []uint `json:"IDs"`
	}
	// FindAnnouncementInfoReq 查找公告请求参数
	// 根据ID获取公告详情时提交的数据
	FindAnnouncementInfoReq {
		// ID 公告ID
		ID *uint `json:"ID,optional" form:"ID,optional"`
	}
	// GetAnnouncementInfoListReq 获取公告列表请求参数
	// 分页查询公告列表时提交的数据
	GetAnnouncementInfoListReq {
		// PageInfo 内嵌字段
		PageInfo
		// StartCreatedAt 创建时间起始范围，可选参数
		StartCreatedAt string `json:"startCreatedAt,optional" form:"startCreatedAt,optional"`
		// EndCreatedAt 创建时间结束范围，可选参数
		EndCreatedAt string `json:"endCreatedAt,optional" form:"endCreatedAt,optional"`
	}
	// AnnouncementInfoRes 公告响应
	// 公告详细信息
	AnnouncementInfoRes {
		// Info 公告信息
		Info AnnouncementInfo `json:"info"`
	}
	// InfoDataSourceItem 信息数据源条目
	// 用于下拉选择的数据源
	InfoDataSourceItem {
		// Label 显示名称
		Label string `json:"label"`
		// Value 值
		Value uint `json:"value"`
	}
	// GetInfoPublicRes 获取公开信息响应
	// 公开接口返回的数据结构
	GetInfoPublicRes {
		// Success 是否成功
		Success bool `json:"success"`
		// Data 数据源条目
		Data InfoDataSourceItem `json:"data"`
	}
)

// 示例模块类型定义
type (
	// ExaCustomer 示例客户模型
	// 示例客户信息
	ExaCustomer {
		// ID 客户ID
		ID uint `json:"ID"`
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// CustomerName 客户名称
		CustomerName string `json:"customerName"`
		// CustomerPhoneData 客户电话
		CustomerPhoneData string `json:"customerPhoneData"`
		// SysUserID 管理用户ID
		SysUserID uint `json:"sysUserId"`
		// SysUserAuthorityID 管理角色ID
		SysUserAuthorityID uint `json:"sysUserAuthorityID"`
		// SysUser 关联用户信息
		SysUser SysUser `json:"sysUser"`
	}
	// ExaCustomerRes 示例客户响应
	// 客户详细信息
	ExaCustomerRes {
		// Customer 客户信息
		Customer ExaCustomer `json:"customer"`
	}
	// GetExaCustomerListReq 获取客户列表请求参数
	// 分页查询客户列表时提交的数据
	GetExaCustomerListReq {
		// PageInfo 内嵌字段
		PageInfo
	}
	// CreateExaCustomerReq 创建客户请求参数
	// 创建客户时提交的数据
	CreateExaCustomerReq {
		// CustomerName 客户名称
		CustomerName string `json:"customerName"`
		// CustomerPhoneData 客户电话
		CustomerPhoneData string `json:"customerPhoneData"`
	}
	// UpdateExaCustomerReq 更新客户请求参数
	// 更新客户信息时提交的数据
	UpdateExaCustomerReq {
		// ID 客户ID
		ID uint `json:"id"`
		// CustomerName 客户名称
		CustomerName string `json:"customerName"`
		// CustomerPhoneData 客户电话
		CustomerPhoneData string `json:"customerPhoneData"`
	}
	// ExaFileUploadAndDownload 文件上传下载模型
	// 文件信息
	ExaFileUploadAndDownload {
		// ID 文件ID
		ID uint `json:"ID"`
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// Name 文件名
		Name string `json:"name"`
		// ClassId 分类ID
		ClassId int `json:"classId"`
		// Url 文件URL
		Url string `json:"url"`
		// Tag 标签
		Tag string `json:"tag"`
		// Key 文件Key
		Key string `json:"key"`
		// Size 文件大小（字节）
		Size int64 `json:"size"`
	}
	// ExaFileRes 文件响应
	// 文件详细信息
	ExaFileRes {
		// File 文件信息
		File ExaFileUploadAndDownload `json:"file"`
	}
	// GetExaFileListReq 获取文件列表请求参数
	// 分页查询文件列表时提交的数据
	GetExaFileListReq {
		// PageInfo 内嵌字段
		PageInfo
	}
	// EditFileNameReq 编辑文件名请求参数
	// 编辑文件名或备注时提交的数据
	EditFileNameReq {
		// ID 文件ID
		ID uint `json:"id"`
		// Name 文件名
		Name string `json:"name"`
	}
	// BreakpointContinueReq 断点续传请求参数
	// 断点续传时提交的数据
	BreakpointContinueReq {
		// File 文件信息
		File string `json:"file"`
		// SliceNum 切片序号
		SliceNum int `json:"sliceNum"`
		// SliceSize 切片大小
		SliceSize int64 `json:"sliceSize"`
		// FileSize 文件总大小
		FileSize int64 `json:"fileSize"`
		// Md5 文件MD5
		Md5 string `json:"md5"`
		// FileName 文件名
		FileName string `json:"fileName"`
	}
	// BreakpointContinueFinishReq 断点续传完成请求参数
	// 切片传输完成时提交的数据
	BreakpointContinueFinishReq {
		// FileMd5 文件MD5
		FileMd5 string `json:"fileMd5"`
		// SliceNum 切片总数
		SliceNum int `json:"sliceNum"`
		// File 文件信息
		File string `json:"file"`
		// FileName 文件名
		FileName string `json:"fileName"`
	}
	// RemoveChunkReq 删除切片请求参数
	// 删除切片时提交的数据
	RemoveChunkReq {
		// FileMd5 文件MD5
		FileMd5 string `json:"fileMd5"`
	}
	// ImportFileUrlReq 导入URL请求参数
	// 通过URL导入文件时提交的数据
	ImportFileUrlReq {
		// Url 文件URL
		Url string `json:"url"`
	}
	// ExaAttachmentCategory 附件分类模型
	// 附件分类信息
	ExaAttachmentCategory {
		// ID 分类ID
		ID uint `json:"ID"`
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// Name 分类名称
		Name string `json:"name"`
		// Pid 父节点ID
		Pid uint `json:"pid"`
		// Children 子分类，仅在获取分类列表时填充
		Children []ExaAttachmentCategory `json:"children"`
	}
	// ExaAttachmentCategoryRes 附件分类响应
	// 附件分类详细信息
	ExaAttachmentCategoryRes {
		// Category 分类信息
		Category ExaAttachmentCategory `json:"category"`
	}
	// GetDictionaryDetailsByParentReq 按父级获取字典详情请求
	// 根据字典ID与父级ID查询字典详情
	GetDictionaryDetailsByParentReq {
		// SysDictionaryID 字典ID
		// 原 Gin 请求结构体 GetDictionaryDetailsByParentRequest 的字段
		SysDictionaryID int `json:"sysDictionaryID,optional" form:"sysDictionaryID,optional"`
		// ParentID 父级字典ID，可选参数
		ParentID *uint `json:"parentID,optional" form:"parentID,optional"`
		// IncludeChildren 是否包含子级，可选参数
		IncludeChildren bool `json:"includeChildren,optional" form:"includeChildren,optional"`
	}
	// GetApiRolesReq 获取API关联角色请求
	// 根据API路径和请求方法查询已关联的角色
	// 原 Gin 通过 c.Query("path") / c.Query("method") 取值
	GetApiRolesReq {
		// Path API路径
		Path string `json:"path,optional" form:"path,optional"`
		// Method 请求方法
		Method string `json:"method,optional" form:"method,optional"`
	}
	// GetDictionaryTreeListByTypeReq 按字典类型获取层级字典树请求
	// 原 Gin 通过 c.Query("type") 取值
	GetDictionaryTreeListByTypeReq {
		// Type 字典类型标识
		Type string `json:"type,optional" form:"type,optional"`
	}
	// ExportTemplateReq 导出模板请求
	// 原 Gin 导出相关接口通过 c.Query("templateID") 取值
	ExportTemplateReq {
		// TemplateID 模板标识
		TemplateID string `json:"templateID,optional" form:"templateID,optional"`
	}
	// ImportSysDictionaryReq 导入字典请求
	// 导入字典时提交的JSON数据
	ImportSysDictionaryReq {
		// Json 字典JSON内容
		Json string `json:"json"`
	}
	// ImportSysDictionaryData 导入字典 JSON 数据结构
	// 对齐原 Gin 反序列化目标 system.SysDictionary，保留 ID / parentID 以还原父子层级
	ImportSysDictionaryData {
		// Name 字典名称
		Name string `json:"name"`
		// Type 字典类型标识
		Type string `json:"type"`
		// Status 状态
		Status *bool `json:"status"`
		// Desc 字典描述
		Desc string `json:"desc"`
		// SysDictionaryDetails 字典详情列表
		SysDictionaryDetails []SysDictionaryDetail `json:"sysDictionaryDetails"`
	}
	// SyncApiItem 同步API条目
	// 单个待同步/待忽略的API定义
	SyncApiItem {
		// Path API路径
		Path string `json:"path"`
		// Method 请求方法
		Method string `json:"method"`
	}
	// SyncApiResp 同步API响应
	// 同步结果中的新增、删除、忽略API列表
	SyncApiResp {
		// NewApis 新增的API列表
		NewApis []SysApi `json:"newApis"`
		// DeleteApis 删除的API列表
		DeleteApis []SysApi `json:"deleteApis"`
		// IgnoreApis 忽略的API列表
		IgnoreApis []SysApi `json:"ignoreApis"`
	}
	// CreateSysParamsReq 创建参数配置请求
	// 新增系统参数时提交的数据
	CreateSysParamsReq {
		// Name 参数名称
		Name string `json:"name"`
		// Key 参数键名
		Key string `json:"key"`
		// Value 参数值
		Value string `json:"value"`
		// Desc 参数描述
		Desc string `json:"desc"`
	}
	// UpdateSysParamsReq 更新参数配置请求
	// 更新系统参数时提交的数据
	UpdateSysParamsReq {
		// ID 参数ID
		ID uint `json:"id"`
		// Name 参数名称
		Name string `json:"name"`
		// Key 参数键名
		Key string `json:"key"`
		// Value 参数值
		Value string `json:"value"`
		// Desc 参数描述
		Desc string `json:"desc"`
	}
	// CreateSysErrorReq 创建错误日志请求
	// 新增错误日志时提交的数据
	CreateSysErrorReq {
		// Form 错误来源
		Form *string `json:"form"`
		// Info 错误信息
		Info *string `json:"info"`
		// Level 错误级别
		Level string `json:"level"`
		// Solution 解决方案
		Solution *string `json:"solution"`
		// Status 处理状态
		Status string `json:"status"`
	}
)

// 邮件模块类型定义
type (
	// EmailSendReq 发送邮件请求参数
	// 发送邮件时提交的数据
	EmailSendReq {
		// To 收件人邮箱，多个用逗号分隔
		To string `json:"to"`
		// Subject 邮件主题
		Subject string `json:"subject"`
		// Body 邮件正文
		Body string `json:"body"`
	}
)

// ==================== 服务定义 ====================
// 公共路由配置
@server (
	group: base
)
service admin-api {
	// Health 健康检查接口
	// 用于检查服务是否正常运行
	@handler Health
	get /health

	// Login 用户登录接口
	// 验证用户名密码并返回JWT令牌
	@handler Login
	post /base/login (LoginReq) returns (LoginResp)

	// Captcha 获取验证码接口
	// 生成并返回验证码图片
	@handler Captcha
	post /base/captcha returns (Captcha)

	// InitDB 初始化数据库接口
	// 执行数据库初始化操作
	@handler InitDB
	post /init/initdb

	// CheckDB 检查数据库接口
	// 检查数据库连接和状态
	@handler CheckDB
	post /init/checkdb
}

// 用户路由配置
@server (
	group:      user
	prefix:     /user
	middleware: CasbinHandler
)
service admin-api {
	// Register 管理员注册接口
	// 管理员创建新用户账号
	@handler Register
	post /admin_register (RegisterReq) returns (SysUserResponse)

	// ChangePassword 修改密码接口
	// 用户修改自己的密码
	@handler ChangePassword
	post /changePassword (ChangePasswordReq) returns (Response)

	// SetUserAuthority 设置用户权限接口
	// 更改用户的角色权限
	@handler SetUserAuthority
	post /setUserAuthority (SetUserAuthReq) returns (Response)

	// DeleteUser 删除用户接口
	// 删除指定用户账号
	@handler DeleteUser
	delete /deleteUser (GetById) returns (Response)

	// SetUserInfo 设置用户信息接口
	// 更新用户的基本信息
	@handler SetUserInfo
	put /setUserInfo (ChangeUserInfoReq) returns (Response)

	// SetSelfInfo 设置自身信息接口
	// 用户更新自己的信息
	@handler SetSelfInfo
	put /setSelfInfo (ChangeUserInfoReq) returns (Response)

	// SetUserAuthorities 设置用户权限组接口
	// 批量设置用户的角色权限
	@handler SetUserAuthorities
	post /setUserAuthorities (SetUserAuthoritiesReq) returns (Response)

	// ResetPassword 重置密码接口
	// 管理员重置用户密码
	@handler ResetPassword
	post /resetPassword (ResetPasswordReq) returns (Response)

	// SetSelfSetting 设置自身配置接口
	// 用户更新自己的界面配置
	@handler SetSelfSetting
	put /setSelfSetting

	// GetUserList 获取用户列表接口
	// 分页查询用户列表
	@handler GetUserList
	post /getUserList (GetUserListReq) returns (PageResult)

	// GetUserInfo 获取用户信息接口
	// 获取当前登录用户的信息
	@handler GetUserInfo
	get /getUserInfo returns (UserInfoRes)
}

// JWT路由配置
@server (
	group:      jwt
	prefix:     /jwt
	middleware: CasbinHandler
)
service admin-api {
	// JsonInBlacklist JWT加入黑名单接口
	// 将当前请求携带的 JWT 加入黑名单，token 取自请求头，原 Gin 接口无入参
	@handler JsonInBlacklist
	post /jsonInBlacklist returns (Response)
}

// API管理路由配置
@server (
	group:      api
	prefix:     /api
	middleware: CasbinHandler
)
service admin-api {
	// GetApiGroups 获取API分组接口
	// 获取所有API分组列表
	@handler GetApiGroups
	get /getApiGroups returns (ApiGroups)

	// SyncApi 同步API接口
	// 同步API接口信息
	@handler SyncApi
	get /syncApi (SyncApiReq) returns (Response)

	// IgnoreApi 忽略API接口
	// 忽略指定API接口
	@handler IgnoreApi
	post /ignoreApi

	// EnterSyncApi 进入同步API接口
	// 进入API同步模式
	@handler EnterSyncApi
	post /enterSyncApi

	// CreateApi 创建API接口
	// 创建新的API接口定义
	@handler CreateApi
	post /createApi (CreateApiReq) returns (Response)

	// DeleteApi 删除API接口
	// 删除指定API接口
	@handler DeleteApi
	post /deleteApi (GetById) returns (Response)

	// GetApiById 获取API详情接口
	// 根据ID获取API详细信息
	@handler GetApiById
	post /getApiById (GetById) returns (SysApi)

	// UpdateApi 更新API接口
	// 更新API接口信息
	@handler UpdateApi
	post /updateApi (UpdateApiReq) returns (Response)

	// DeleteApisByIds 批量删除API接口
	// 批量删除API接口
	@handler DeleteApisByIds
	delete /deleteApisByIds (IdsReq) returns (Response)

	// SetApiRoles 设置API角色接口
	// 分配API给角色
	@handler SetApiRoles
	post /setApiRoles (SetApiRolesReq) returns (Response)

	// GetAllApis 获取所有API接口
	// 获取所有API列表
	@handler GetAllApis
	post /getAllApis (GetAllApisReq) returns ([]SysApi)

	// GetApiList 获取API列表接口
	// 分页查询API列表
	@handler GetApiList
	post /getApiList (GetApiListReq) returns (PageResult)

	// GetApiRoles 获取API角色接口
	// 获取API关联的角色ID列表（原 Gin 返回 []uint）
	@handler GetApiRoles
	get /getApiRoles (GetApiRolesReq) returns ([]uint)

	// FreshCasbin 刷新Casbin接口
	// 刷新权限策略缓存
	@handler FreshCasbin
	get /freshCasbin returns (Response)
}

// 权限管理路由配置
@server (
	group:      authority
	prefix:     /authority
	middleware: CasbinHandler
)
service admin-api {
	// CreateAuthority 创建权限接口
	// 创建新的角色权限
	@handler CreateAuthority
	post /createAuthority (CreateAuthorityReq) returns (Response)

	// DeleteAuthority 删除权限接口
	// 删除指定角色权限
	@handler DeleteAuthority
	post /deleteAuthority (GetById) returns (Response)

	// UpdateAuthority 更新权限接口
	// 更新角色权限信息
	@handler UpdateAuthority
	put /updateAuthority (UpdateAuthorityReq) returns (Response)

	// CopyAuthority 复制权限接口
	// 复制角色权限配置
	@handler CopyAuthority
	post /copyAuthority (CopyAuthorityReq) returns (Response)

	// SetDataAuthority 设置数据权限接口
	// 配置角色的数据权限范围
	@handler SetDataAuthority
	post /setDataAuthority (SetDataAuthorityReq) returns (Response)

	// SetRoleUsers 设置角色用户接口
	// 批量设置角色的用户列表
	@handler SetRoleUsers
	post /setRoleUsers (SetRoleUsersReq) returns (Response)

	// GetAuthorityList 获取权限列表接口
	// 分页查询角色权限列表
	@handler GetAuthorityList
	post /getAuthorityList (GetAuthorityListReq) returns (PageResult)

	// GetUsersByAuthority 获取角色用户接口
	// 获取角色下的用户ID列表（原 Gin 返回 []uint）
	@handler GetUsersByAuthority
	get /getUsersByAuthority (SetRoleUsersReq) returns ([]uint)
}

// 菜单管理路由配置
@server (
	group:      menu
	prefix:     /menu
	middleware: CasbinHandler
)
service admin-api {
	// AddBaseMenu 添加菜单接口
	// 创建新的菜单项
	@handler AddBaseMenu
	post /addBaseMenu (AddMenuReq) returns (Response)

	// AddMenuAuthority 添加菜单权限接口
	// 分配菜单给角色
	@handler AddMenuAuthority
	post /addMenuAuthority (AddMenuAuthorityReq) returns (Response)

	// DeleteBaseMenu 删除菜单接口
	// 删除指定菜单项
	@handler DeleteBaseMenu
	post /deleteBaseMenu (DeleteMenuReq) returns (Response)

	// UpdateBaseMenu 更新菜单接口
	// 更新菜单信息
	@handler UpdateBaseMenu
	post /updateBaseMenu (UpdateMenuReq) returns (Response)

	// SetMenuRoles 设置菜单角色接口
	// 分配菜单权限给多个角色
	@handler SetMenuRoles
	post /setMenuRoles (SetMenuRolesReq) returns (Response)

	// GetMenu 获取菜单接口
	// 获取当前登录用户角色的动态路由菜单，authorityId 取自 JWT 上下文，原 Gin 接口无入参
	@handler GetMenu
	post /getMenu returns (MenuRes)

	// GetMenuList 获取菜单列表接口
	// 获取菜单列表
	@handler GetMenuList
