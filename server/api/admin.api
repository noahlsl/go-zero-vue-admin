	// 获取AI技能详细信息
	@handler GetSkillDetail
	post /getSkillDetail (GetById) returns (SkillDetailRes)

	// SaveSkill 保存技能接口
	// 保存或更新AI技能
	@handler SaveSkill
	post /saveSkill (SaveSkillReq) returns (Response)

	// DeleteSkill 删除技能接口
	// 删除指定AI技能
	@handler DeleteSkill
	post /deleteSkill (DeleteSkillReq) returns (Response)

	// CreateScript 创建脚本接口
	// 创建新的AI脚本
	@handler CreateScript
	post /createScript (CreateScriptReq) returns (Response)

	// GetScript 获取脚本接口
	// 获取AI脚本详细信息
	@handler GetScript
	post /getScript (GetScriptReq) returns (ScriptDetailRes)

	// SaveScript 保存脚本接口
	// 保存或更新AI脚本
	@handler SaveScript
	post /saveScript (SaveScriptReq) returns (Response)

	// CreateResource 创建资源接口
	// 创建新的AI资源
	@handler CreateResource
	post /createResource (CreateResourceReq) returns (Response)

	// GetResource 获取资源接口
	// 获取AI资源详细信息
	@handler GetResource
	post /getResource (GetResourceReq) returns (ResourceDetailRes)

	// SaveResource 保存资源接口
	// 保存或更新AI资源
	@handler SaveResource
	post /saveResource (SaveResourceReq) returns (Response)

	// CreateReference 创建参考接口
	// 创建新的参考文档
	@handler CreateReference
	post /createReference (CreateReferenceReq) returns (Response)

	// GetReference 获取参考接口
	// 获取参考文档详细信息
	@handler GetReference
	post /getReference (GetReferenceReq) returns (ReferenceDetailRes)

	// SaveReference 保存参考接口
	// 保存或更新参考文档
	@handler SaveReference
	post /saveReference (SaveReferenceReq) returns (Response)

	// CreateTemplate 创建模板接口
	// 创建新的AI模板
	@handler CreateTemplate
	post /createTemplate (CreateTemplateReq) returns (Response)

	// GetTemplate 获取模板接口
	// 获取AI模板详细信息
	@handler GetTemplate
	post /getTemplate (GetTemplateReq) returns (TemplateDetailRes)

	// SaveTemplate 保存模板接口
	// 保存或更新AI模板
	@handler SaveTemplate
	post /saveTemplate (SaveTemplateReq) returns (Response)

	// GetGlobalConstraint 获取全局约束接口
	// 获取AI全局约束配置
	@handler GetGlobalConstraint
	post /getGlobalConstraint returns (GlobalConstraintRes)

	// SaveGlobalConstraint 保存全局约束接口
	// 保存AI全局约束配置
	@handler SaveGlobalConstraint
	post /saveGlobalConstraint (SaveGlobalConstraintReq) returns (Response)

	// PackageSkill 打包技能接口
	// 打包AI技能
	@handler PackageSkill
	post /packageSkill (PackageSkillReq) returns (Response)

	// DownloadOnlineSkill 下载在线技能接口
	// 从在线地址下载AI技能
	@handler DownloadOnlineSkill
	post /downloadOnlineSkill (DownloadOnlineSkillReq) returns (DownloadOnlineSkillRes)
}

// 示例模块路由配置
@server (
	group:      example
	prefix:     /customer
	middleware: CasbinHandler
)
service admin-api {
	// CreateCustomer 创建客户接口
	// 创建新的客户
	@handler CreateCustomer
	post /customer (CreateExaCustomerReq) returns (Response)

	// UpdateCustomer 更新客户接口
	// 更新客户信息
	@handler UpdateCustomer
	put /customer (UpdateExaCustomerReq) returns (Response)

	// DeleteCustomer 删除客户接口
	// 删除指定客户
	@handler DeleteCustomer
	delete /customer (GetById) returns (Response)

	// GetCustomer 获取客户接口
	// 根据ID获取客户详情
	@handler GetCustomer
	get /customer (GetById) returns (ExaCustomerRes)

	// GetCustomerList 获取客户列表接口
	// 分页查询客户列表
	@handler GetCustomerList
	get /customerList (GetExaCustomerListReq) returns (PageResult)
}

// 文件上传下载路由定义
@server (
	group:      file
	prefix:     /fileUploadAndDownload
	middleware: CasbinHandler
)
service admin-api {
	// UploadFile 上传文件接口
	// 上传文件
	@handler UploadFile
	post /upload returns (ExaFileRes)

	// DeleteFile 删除文件接口
	// 删除指定文件
	@handler DeleteFile
	post /deleteFile (GetById) returns (Response)

	// EditFileName 编辑文件名接口
	// 编辑文件名或备注
	@handler EditFileName
	post /editFileName (EditFileNameReq) returns (Response)

	// BreakpointContinue 断点续传接口
	// 断点续传上传切片
	@handler BreakpointContinue
	post /breakpointContinue (BreakpointContinueReq) returns (Response)

	// FindFile 查找文件接口
	// 查询当前文件成功的切片
	@handler FindFile
	get /findFile (GetById) returns (ExaFileRes)

	// BreakpointContinueFinish 断点续传完成接口
	// 切片传输完成
	@handler BreakpointContinueFinish
	post /breakpointContinueFinish (BreakpointContinueFinishReq) returns (Response)

	// RemoveChunk 删除切片接口
	// 删除切片
	@handler RemoveChunk
	post /removeChunk (RemoveChunkReq) returns (Response)

	// ImportFileUrl 导入URL接口
	// 通过URL导入文件
	@handler ImportFileUrl
	post /importURL (ImportFileUrlReq) returns (ExaFileRes)

	// GetFileList 获取文件列表接口
	// 分页查询文件列表
	@handler GetFileList
	post /getFileList (GetExaFileListReq) returns (PageResult)
}

@server (
	group:      attachment
	prefix:     /attachmentCategory
	middleware: CasbinHandler
)
service admin-api {
	// GetCategoryList 获取分类列表接口
	// 获取附件分类树，原 Gin 接口无入参，data 直接返回数组
	@handler GetCategoryList
	get /getCategoryList returns ([]ExaAttachmentCategory)

	// AddCategory 创建分类接口
	// 创建或编辑附件分类
	@handler AddCategory
	post /addCategory (ExaAttachmentCategory) returns (Response)

	// DeleteCategory 删除分类接口
	// 删除指定附件分类
	@handler DeleteCategory
	post /deleteCategory (GetById) returns (Response)
}

// 邮件模块路由配置
@server (
	group:      email
	prefix:     /email
	middleware: JwtHandler,CasbinHandler
)
service admin-api {
	// EmailTest 测试邮件接口
	// 发送测试邮件验证邮件服务是否正常
	@handler EmailTest
	post /emailTest returns (Response)

	// SendEmail 发送邮件接口
	// 向指定收件人发送邮件
	@handler SendEmail
	post /sendEmail (EmailSendReq) returns (Response)
}

