syntax = "v1"

info (
	title:  "go-zero-vue-admin api"
	desc:   "go-zero-vue-admin 后端API接口定义"
	author: "go-zero-vue-admin"
	date:   "2024-01-01"
)

// 通用类型定义
type (
	// Response 通用响应结构体
	// 用于所有接口的统一响应格式
	Response {
		// Code 状态码，0表示成功，7表示失败
		Code int `json:"code"`
		// Data 响应数据，可以是任意类型
		Data interface{} `json:"data"`
		// Msg 响应消息，描述操作结果
		Msg string `json:"msg"`
	}
	// SqlPreviewRes SQL预览响应
	// key 与原 Gin 的 gin.H{"sql": ...} 一致
	SqlPreviewRes {
		// Sql 预览生成的 SQL
		Sql string `json:"sql"`
	}
	// PageInfo 分页请求参数
	// 用于列表查询的分页参数
	PageInfo {
		// Page 页码，从1开始
		// form tag 供 httpx.Parse 解析 GET query，json tag 供 JSON body 解析，两者都必须为 optional
		Page int `json:"page,optional" form:"page,optional"`
		// PageSize 每页数量，默认10，最大100
		PageSize int `json:"pageSize,optional" form:"pageSize,optional"`
		// Keyword 搜索关键字，可选参数
		Keyword string `json:"keyword,optional" form:"keyword,optional"`
	}
	// PageResult 分页响应结果
	// 包含分页查询的返回数据
	PageResult {
		// List 数据列表
		List interface{} `json:"list"`
		// Total 总记录数
		Total int64 `json:"total"`
		// Page 当前页码
		Page int `json:"page"`
		// PageSize 每页数量
		PageSize int `json:"pageSize"`
	}
	// GetById 根据ID查询请求
	// 用于单个资源的查询和删除操作
	GetById {
		// ID 资源ID
		// 原 Gin 接口统一使用大写 ID 作为 query key，故 form tag 必须为大写 ID
		ID int `json:"id,optional" form:"ID,optional"`
	}
	// GetByLowerId 小写 id 查询请求
	// 兼容原 Gin 中 query key 为全小写 id 的接口（getSysErrorSolution / getDictionaryPath）
	GetByLowerId {
		// ID 资源ID
		ID int `json:"id,optional" form:"id,optional"`
	}
	// IdsReq 批量删除请求
	// 用于批量删除操作
	IdsReq {
		// Ids 资源ID列表
		Ids []int `json:"ids"`
	}
)

// 系统模块类型定义
type (
	// LoginReq 登录请求参数
	// 用户登录时提交的表单数据
	LoginReq {
		// Username 用户名
		Username string `json:"username"`
		// Password 密码
		Password string `json:"password"`
		// Captcha 验证码
		Captcha string `json:"captcha,optional"`
		// CaptchaId 验证码ID
		CaptchaId string `json:"captchaId,optional"`
	}
	// LoginResp 登录响应结果
	// 登录成功后返回的数据
	LoginResp {
		// User 用户信息
		User SysUser `json:"user"`
		// Token JWT令牌
		Token string `json:"token"`
		// ExpiresAt 令牌过期时间戳（毫秒）
		ExpiresAt int64 `json:"expiresAt"`
	}
	// RegisterReq 注册请求参数
	// 管理员注册新用户时提交的数据
	RegisterReq {
		// Username 用户名
		Username string `json:"userName"`
		// Password 密码
		Password string `json:"passWord"`
		// NickName 昵称
		NickName string `json:"nickName"`
		// HeaderImg 头像链接，可选参数
		HeaderImg string `json:"headerImg,optional"`
		// AuthorityId 角色ID
		AuthorityId uint `json:"authorityId"`
		// Enable 是否启用，1启用，0禁用
		Enable int `json:"enable"`
		// AuthorityIds 角色ID列表，可选参数
		AuthorityIds []uint `json:"authorityIds,optional"`
		// Phone 电话号码，可选参数
		Phone string `json:"phone,optional"`
		// Email 电子邮箱，可选参数
		Email string `json:"email,optional"`
	}
	// ChangePasswordReq 修改密码请求参数
	// 用户修改密码时提交的数据
	ChangePasswordReq {
		// Password 原密码
		Password string `json:"password"`
		// NewPassword 新密码
		NewPassword string `json:"newPassword"`
	}
	// ResetPasswordReq 重置密码请求参数
	// 管理员重置用户密码时提交的数据
	ResetPasswordReq {
		// ID 用户ID
		ID uint `json:"ID"`
		// Password 新密码
		Password string `json:"password"`
	}
	// SetUserAuthReq 设置用户权限请求参数
	// 更改用户角色时提交的数据
	SetUserAuthReq {
		// AuthorityId 角色ID
		AuthorityId uint `json:"authorityId"`
	}
	// SetUserAuthoritiesReq 设置用户权限组请求参数
	// 批量设置用户角色时提交的数据
	SetUserAuthoritiesReq {
		// ID 用户ID
		ID uint `json:"ID"`
		// AuthorityIds 角色ID列表
		AuthorityIds []uint `json:"authorityIds"`
	}
	// ChangeUserInfoReq 修改用户信息请求参数
	// 更新用户信息时提交的数据
	ChangeUserInfoReq {
		// ID 用户ID
		ID uint `json:"id"`
		// NickName 昵称，可选参数
		NickName string `json:"nickName,optional"`
		// Phone 电话号码，可选参数
		Phone string `json:"phone,optional"`
		// AuthorityIds 角色ID列表，可选参数
		AuthorityIds []uint `json:"authorityIds,optional"`
		// Email 电子邮箱，可选参数
		Email string `json:"email,optional"`
		// HeaderImg 头像链接，可选参数
		HeaderImg string `json:"headerImg,optional"`
		// Enable 是否启用，可选参数
		Enable int `json:"enable,optional"`
	}
	// GetUserListReq 获取用户列表请求参数
	// 分页查询用户列表时提交的数据
	GetUserListReq {
		// PageInfo 内嵌字段
		PageInfo
		// Username 用户名，可选参数
		Username string `json:"username,optional" form:"username,optional"`
		// NickName 昵称，可选参数
		NickName string `json:"nickName,optional" form:"nickName,optional"`
		// Phone 电话号码，可选参数
		Phone string `json:"phone,optional" form:"phone,optional"`
		// Email 电子邮箱，可选参数
		Email string `json:"email,optional" form:"email,optional"`
		// OrderKey 排序字段，可选参数
		OrderKey string `json:"orderKey,optional" form:"orderKey,optional"`
		// Desc 排序方式，true降序，false升序，可选参数
		Desc bool `json:"desc,optional" form:"desc,optional"`
	}
	// SysUser 系统用户模型
	// 包含用户的基本信息和关联数据
	SysUser {
		// ID 用户ID
		ID uint `json:"ID"`
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// UUID 用户唯一标识
		UUID string `json:"uuid"`
		// Username 用户名
		Username string `json:"userName"`
		// NickName 昵称
		NickName string `json:"nickName"`
		// Password 密码（不返回给前端）
		Password string `json:"-"`
		// HeaderImg 头像链接
		HeaderImg string `json:"headerImg"`
		// AuthorityId 角色ID
		AuthorityId uint `json:"authorityId"`
		// Authority 角色信息
		Authority SysAuthority `json:"authority"`
		// Authorities 角色列表
		Authorities []SysAuthority `json:"authorities"`
		// Phone 电话号码
		Phone string `json:"phone"`
		// Email 电子邮箱
		Email string `json:"email"`
		// Enable 是否启用，1启用，0禁用
		Enable int `json:"enable"`
		// OriginSetting 原始配置信息
		OriginSetting interface{} `json:"originSetting"`
	}
	// SysUserResponse 用户信息响应
	// 包装用户信息的响应结构
	SysUserResponse {
		// User 用户信息
		User SysUser `json:"user"`
	}
	// UserInfoRes 当前登录用户信息响应
	// 字段名与原 Gin 后端保持一致，前端通过 data.userInfo 读取
	UserInfoRes {
		// UserInfo 用户信息
		UserInfo SysUser `json:"userInfo"`
	}
	// SysAuthority 系统权限模型
	// 包含角色的基本信息和关联数据
	SysAuthority {
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// AuthorityId 角色ID
		AuthorityId uint `json:"authorityId"`
		// AuthorityName 角色名称
		AuthorityName string `json:"authorityName"`
		// ParentId 父角色ID
		ParentId uint `json:"parentId"`
		// DefaultRouter 默认路由
		DefaultRouter string `json:"defaultRouter"`
		// DataScope 数据权限范围
		DataScope string `json:"dataScope"`
		// Children 子角色列表
		Children []SysAuthority `json:"children"`
		// Menus 菜单列表
		Menus []SysMenu `json:"menus"`
		// Local 是否本地角色
		Local *bool `json:"local"`
		// AuthorityIdStr 角色ID字符串表示
		AuthorityIdStr string `json:"authorityIdStr"`
	}
	// Meta 菜单元数据
	// 菜单的附加属性
	Meta {
		// Title 菜单标题
		Title string `json:"title"`
		// Icon 菜单图标
		Icon string `json:"icon"`
		// KeepAlive 是否缓存
		KeepAlive bool `json:"keepAlive"`
		// DefaultMenu 是否默认菜单
		DefaultMenu bool `json:"defaultMenu"`
		// CloseTab 是否关闭标签页
		CloseTab bool `json:"closeTab"`
		// TransitionType 路由切换动画
		TransitionType string `json:"transitionType"`
	}
	// SysMenu 系统菜单模型
	// 包含菜单的基本信息和配置
	SysMenu {
		// ID 菜单ID
		ID uint `json:"ID"`
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// MenuLevel 菜单层级
		MenuLevel uint `json:"menuLevel"`
		// ParentId 父菜单ID
		ParentId uint `json:"parentId"`
		// Path 路由路径
		Path string `json:"path"`
		// Name 路由名称
		Name string `json:"name"`
		// Hidden 是否隐藏
		Hidden bool `json:"hidden"`
		// Component 组件路径
		Component string `json:"component"`
		// Sort 排序号
		Sort int `json:"sort"`
		// Meta 菜单元数据
		Meta Meta `json:"meta"`
		// AuthorityId 角色ID
		AuthorityId uint `json:"authorityId"`
		// Button 按钮列表
		Button []SysMenuBtn `json:"menuBtn"`
		// Buttons 按钮权限列表
		Buttons []SysAuthorityBtn `json:"buttons"`
		// HideTab 是否隐藏标签页
		HideTab bool `json:"hideTab"`
		// MenuId 菜单ID（关联）
		MenuId uint `json:"menuId"`
		// Children 子菜单列表
		Children []SysMenu `json:"children"`
		// Parameters 菜单参数列表
		Parameters []SysMenuParameter `json:"parameters"`
	}
	// SysMenuBtn 系统菜单按钮模型
	// 菜单下的按钮定义
	SysMenuBtn {
		// ID 按钮ID
		ID uint `json:"ID"`
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// Name 按钮名称
		Name string `json:"name"`
		// Desc 按钮描述
		Desc string `json:"desc"`
		// ButtonId 按钮标识ID
		ButtonId uint `json:"buttonId"`
	}
	// SysMenuParameter 系统菜单参数模型
	// 菜单的地址栏参数
	SysMenuParameter {
		// ID 参数ID
		ID uint `json:"ID"`
		// SysBaseMenuID 菜单ID
		SysBaseMenuID uint `json:"sysBaseMenuID"`
		// Type 参数类型
		Type string `json:"type"`
		// Key 参数键
		Key string `json:"key"`
		// Value 参数值
		Value string `json:"value"`
	}
	// SysAuthorityBtn 系统按钮权限模型
	// 角色拥有的按钮权限
	SysAuthorityBtn {
		// ID 权限ID
		ID uint `json:"ID"`
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// Name 权限名称
		Name string `json:"name"`
		// Desc 权限描述
		Desc string `json:"desc"`
		// BtnId 按钮ID
		BtnId uint `json:"btnId"`
	}
	// SysDictionary 系统字典模型
	// 字段与原 Gin model.SysDictionary 的 JSON 输出保持一致
	SysDictionary {
		// ID 字典ID
		ID uint `json:"ID"`
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// Name 字典名称
		Name string `json:"name"`
		// Type 字典类型标识
		Type string `json:"type"`
		// Status 状态，对齐原 Gin 的 *bool
		Status *bool `json:"status"`
		// Desc 字典描述
		Desc string `json:"desc"`
		// ParentID 父级字典ID，对齐原 Gin 的 *uint
		ParentID *uint `json:"parentID"`
		// Children 子字典列表
		Children []SysDictionary `json:"children"`
	}
	// SysDictionaryDetail 系统字典详情模型
	// 字段与原 Gin model.SysDictionaryDetail 的 JSON 输出保持一致
	SysDictionaryDetail {
		// ID 详情ID
		ID uint `json:"ID"`
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// Label 标签（显示名称）
		Label string `json:"label"`
		// Value 值
		Value string `json:"value"`
		// Extend 扩展值
		Extend string `json:"extend"`
		// Status 启用状态
		Status *bool `json:"status"`
		// Sort 排序号
		Sort int `json:"sort"`
		// SysDictionaryID 关联字典ID
		SysDictionaryID int `json:"sysDictionaryID"`
		// ParentID 父级字典详情ID
		ParentID *uint `json:"parentID"`
		// Children 子字典详情
		Children []SysDictionaryDetail `json:"children"`
		// Level 层级深度，从 0 开始
		Level int `json:"level"`
		// Path 层级路径，如 "1,2,3"
		Path string `json:"path"`
		// Disabled 禁用状态，根据 status 动态计算
		Disabled bool `json:"disabled"`
	}
	// SysOperationRecord 系统操作记录模型
	// 记录用户的操作日志
	SysOperationRecord {
		// ID 记录ID
		ID uint `json:"ID"`
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// UserId 用户ID
		UserId uint `json:"user_id"`
		// Ip 操作IP地址
		Ip string `json:"ip"`
		// Method 请求方法
		Method string `json:"method"`
		// Path 请求路径
		Path string `json:"path"`
		// Agent 用户代理
		Agent string `json:"agent"`
		// Status 操作状态，1成功，0失败
		Status int `json:"status"`
		// Latency 响应延迟（毫秒）
		Latency int64 `json:"latency"`
		// Body 请求体
		Body string `json:"body"`
		// Resp 响应体
		Resp string `json:"resp"`
	}
	// SysApi 系统API模型
	// API接口定义
	SysApi {
		// ID API ID
		ID uint `json:"ID"`
		// CreatedAt 创建时间（RFC3339）
		CreatedAt string `json:"CreatedAt"`
		// UpdatedAt 更新时间（RFC3339）
		UpdatedAt string `json:"UpdatedAt"`
		// Method 请求方法
		Method string `json:"method"`
		// Path 请求路径
		Path string `json:"path"`
		// ApiGroup API分组
		ApiGroup string `json:"apiGroup"`
		// Description API描述
		Description string `json:"description"`
	}
	// SystemConfig 系统配置模型
	// 系统运行配置
	SystemConfig {
		// System 系统设置
		System System `json:"system"`
	}
	// System 系统设置模型
	// 基础系统配置项
	System {
		// RouterPrefix 路由前缀
		RouterPrefix string `json:"routerPrefix"`
		// UseMultipoint 是否启用多点登录
		UseMultipoint bool `json:"useMultipoint"`
		// ConfigPath 配置文件路径
		ConfigPath string `json:"configPath"`
	}
	// ServerInfo 服务器信息模型
	// 包含服务器硬件和系统信息
	ServerInfo {
		// Cpu CPU信息列表
		Cpu []string `json:"cpu"`
		// Host 主机信息
		Host Host `json:"host"`
		// Mem 内存信息
		Mem Mem `json:"mem"`
		// Os 操作系统信息
		Os Os `json:"os"`
		// Disk 磁盘信息列表
		Disk []Disk `json:"disk"`
	}
	// Host 主机信息模型
	// CPU详细信息
	Host {
		// Name 主机名
		Name string `json:"name"`
		// Core CPU核心数
		Core int `json:"core"`
		// Model CPU型号
		Model string `json:"model"`
		// Mhz CPU频率（MHz）
		Mhz float64 `json:"mhz"`
		// MaxLoadLimit 最大负载限制
		MaxLoadLimit float64 `json:"maxLoadLimit"`
		// IdleLoadPerc 空闲负载百分比
		IdleLoadPerc float64 `json:"idleLoadPerc"`
		// UserLoadPerc 用户负载百分比
		UserLoadPerc float64 `json:"userLoadPerc"`
		// WcpLoadPerc 系统负载百分比
		WcpLoadPerc float64 `json:"wcpLoadPerc"`
		// IOWait IO等待时间
		IOWait float64 `json:"ioWait"`
	}
	// Mem 内存信息模型
	// 内存使用情况
	Mem {
		// Total 总内存（字节）
		Total uint64 `json:"total"`
		// Used 已使用内存（字节）
		Used uint64 `json:"used"`
		// Free 空闲内存（字节）
		Free uint64 `json:"free"`
		// Perc 内存使用百分比
		Perc float64 `json:"perc"`
	}
	// Os 操作系统信息模型
	// 操作系统详细信息
	Os {
		// Arch 系统架构
		Arch string `json:"arch"`
		// Hostname 主机名
		Hostname string `json:"hostname"`
		// Kernel 内核版本
		Kernel string `json:"kernel"`
		// System 操作系统名称
		System string `json:"system"`
		// Platform 平台信息
		Platform string `json:"platform"`
		// Uptime 系统运行时间（秒）
		Uptime uint64 `json:"uptime"`
		// HostID 主机ID
		HostID string `json:"hostID"`
	}
	// Disk 磁盘信息模型
	// 磁盘使用情况
	Disk {
		// Path 磁盘路径
		Path string `json:"path"`
		// Total 总容量（字节）
		Total uint64 `json:"total"`
		// Free 空闲容量（字节）
		Free uint64 `json:"free"`
		// Used 已使用容量（字节）
		Used uint64 `json:"used"`
		// Inodes inode总数
		Inodes uint64 `json:"inodes"`
		// Perc 磁盘使用百分比
		Perc float64 `json:"perc"`
	}
	// Captcha 验证码模型
	// 验证码信息
	Captcha {
		// CaptchaId 验证码ID
		CaptchaId string `json:"captchaId"`
		// PicPath 验证码图片路径
		PicPath string `json:"picPath"`
		// CaptchaLength 验证码长度
		CaptchaLength int `json:"captchaLength"`
		// OpenCaptcha 是否开启验证码
		OpenCaptcha bool `json:"openCaptcha"`
	}
	// ApiGroups API分组响应
	// 所有API分组列表
	ApiGroups {
		// Groups 分组名称列表
		Groups []string `json:"groups"`
	}
	// SyncApiReq 同步API请求参数
	// 同步API接口时提交的数据
	SyncApiReq {
		// NewApis 新增的API列表
		NewApis []SyncApiItem `json:"newApis,optional"`
		// DeleteApis 删除的API列表
		DeleteApis []SyncApiItem `json:"deleteApis,optional"`
		// IgnoreApis 忽略的API列表
		IgnoreApis []SyncApiItem `json:"ignoreApis,optional"`
	}
	// CreateApiReq 创建API请求参数
	// 创建新API时提交的数据
	CreateApiReq {
		// Method 请求方法
		Method string `json:"method"`
		// Path 请求路径
		Path string `json:"path"`
		// ApiGroup API分组
		ApiGroup string `json:"apiGroup"`
		// Description API描述
		Description string `json:"description"`
	}
	// UpdateApiReq 更新API请求参数
	// 更新API信息时提交的数据
	UpdateApiReq {
		// ID API ID
		ID uint `json:"id"`
		// Method 请求方法
		Method string `json:"method"`
		// Path 请求路径
		Path string `json:"path"`
		// ApiGroup API分组
		ApiGroup string `json:"apiGroup"`
		// Description API描述
		Description string `json:"description"`
	}
	// SetApiRolesReq 设置API角色请求参数
	// 分配API给角色时提交的数据
	SetApiRolesReq {
		// Path API路径
		Path string `json:"path"`
