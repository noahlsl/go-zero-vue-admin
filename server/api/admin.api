	// 获取AI工作流会话详细信息
	@handler GetAIWorkflowSessionDetail
	post /getAIWorkflowSessionDetail (GetById) returns (AIWorkflowSessionDetailRes)

	// DeleteAIWorkflowSession 删除AI工作流会话接口
	// 删除AI工作流会话
	@handler DeleteAIWorkflowSession
	post /deleteAIWorkflowSession (DeleteAIWorkflowSessionReq) returns (Response)

